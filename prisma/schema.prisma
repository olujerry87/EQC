generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  clientProfiles   ClientProfile[]
  facilityProfiles FacilityProfile[]
  staffProfiles    StaffProfile[]
  serviceRequests  ServiceRequest[]
  staffingRequests StaffingRequest[]
  visits           Visit[]
  shifts           Shift[]
  auditLogs        AuditLog[]
  alerts           Alert[]
  invoices         Invoice[]
  expenses         Expense[]
  payrollEntries   PayrollEntry[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String? // Nullable for SUPER_ADMIN
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String?
  role         String   @default("CLIENT_FAMILY")
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientProfile   ClientProfile?
  facilityProfile FacilityProfile?
  staffProfile    StaffProfile?
  auditLogs       AuditLog[]
}

model ClientProfile {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  address   String?

  serviceRequests ServiceRequest[]
  visits          Visit[]
}

model FacilityProfile {
  id            String  @id @default(cuid())
  tenantId      String
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String?
  address       String?
  contactPerson String?
  phone         String?

  staffingRequests StaffingRequest[]
}

model StaffProfile {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  roles        String?
  skills       String?
  availability String?

  assignedVisits Visit[]
  assignedShifts Shift[]
  claimedShifts  Shift[]        @relation("ShiftClaimant")
  expenses       Expense[]
  payrollEntries PayrollEntry[]
}

model ServiceRequest {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("PENDING")

  contactName   String
  contactEmail  String
  contactPhone  String?
  schedule      String? // Kept for scheduling

  clientProfileId String?
  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])
}

model StaffingRequest {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("PENDING")

  facilityName String
  contactName  String
  contactEmail String
  contactPhone String?
  facilityType String?
  address      String?

  roleNeeded   String
  shiftDetails String?
  requirements String?
  priority     String?

  facilityProfileId String?
  facilityProfile   FacilityProfile? @relation(fields: [facilityProfileId], references: [id])
  shifts            Shift[]
}

model Visit {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    String   @default("SCHEDULED")

  // EVV Fields
  clockInTime  DateTime?
  clockOutTime DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockOutLat  Float?
  clockOutLng  Float?

  staffId String?
  staff   StaffProfile? @relation(fields: [staffId], references: [id])

  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id])

  rating        Int?
  ratingComment String?
  expenses      Expense[]
}

model Shift {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  status    String   @default("SCHEDULED")

  // Marketplace fields
  isPublic     Boolean  @default(false)
  claimedById  String?
  claimedBy    StaffProfile? @relation("ShiftClaimant", fields: [claimedById], references: [id])
  roleRequired String?

  // EVV Fields
  clockInTime  DateTime?
  clockOutTime DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockOutLat  Float?
  clockOutLng  Float?

  staffId String?
  staff   StaffProfile? @relation(fields: [staffId], references: [id])

  staffingRequestId String
  staffingRequest   StaffingRequest @relation(fields: [staffingRequestId], references: [id])

  rating        Int?
  ratingComment String?
  expenses      Expense[]
}

model Alert {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String   // e.g., "MISSED_SHIFT", "TARDY", "GEOFENCE_VIOLATION"
  message     String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  shiftId     String?
  visitId     String?
}

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  taxAmount   Float    @default(0.0)
  totalAmount Float
  status      String   @default("DRAFT") // DRAFT, SENT, PAID
  createdAt   DateTime @default(now())
  dueDate     DateTime?

  shiftId     String?
  visitId     String?
  clientId    String?
  facilityId  String?
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  category    String   // e.g., "MILEAGE", "SUPPLIES"
  description String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())

  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  shiftId     String?
  shift       Shift?       @relation(fields: [shiftId], references: [id])
  visitId     String?
  visit       Visit?       @relation(fields: [visitId], references: [id])
}

model PayrollEntry {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Float
  taxAmount   Float    @default(0.0)
  netAmount   Float
  status      String   @default("PENDING") // PENDING, PROCESSED
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g., "PROCESS_PAYROLL", "APPROVE_EXPENSE"
  entity    String // e.g., "Invoice", "Expense"
  entityId  String
  metadata  String? // e.g., changed fields, IP address, user-agent
  createdAt DateTime @default(now())
}
